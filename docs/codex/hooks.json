{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-quality.mjs",
            "timeout": 30,
            "statusMessage": "Checking edited TypeScript files"
          }
        ]
      }
    ]
  }
}
